@article{logdberg2012,
	author = "L{\"o}gdberg, F. and Wennergren, U.",
	journal = "Theoretical Ecology",
	notes = "Theoretically separated the influence of synchrony and colour as parts of environmental variation, and used this to examine the influence of colour. They found that the qualitative effects of noise colour didn't differ with the degree of subpopulation synchrony. The redder the noise colour (more autocorrelated env. noise) the lower the extinction risk. They looked at the influence of noise colour for both overcompensatory and undercompensatory dynamical populations, finding a hump shaped relationship; less responsive (undercompensatory populations) have highest extinction risk at intermediate noise colour. They do a good job discussing the relationship of how extinction risk depends on population dynamics, noise colour and the degree of synchrony.",
	pages = "1--10",
	publisher = "Springer",
	title = "{Spectral color, synchrony, and extinction risk}",
	year = "2012"
}

@article{van2011,
	author = "van de Pol, M. and Vindenes, Y. and S{\ae}ther, B.E. and Engen, S. and Ens, B.J. and Oosterbeek, K. and Tinbergen, J.M.",
	journal = "Proceedings of the Royal Society B: Biological Sciences",
	notes = "Extinction risk was largely insensitive to noise colour, because demographic rates are poor in tracking the colour of the environment. We show that three mechanisms-which probably act in many species-can cause poor environmental tracking: (i) demographic rates that depend nonlinearly on environmental variables filter the noise colour, (ii) demographic rates typically depend on several environmental signals that do not change colour synchronously, and (iii) demographic stochasticity whitens the colour of demographic rates at low population size. We argue that the common practice of assuming perfect environmental tracking may result in overemphasizing the importance of noise colour for extinction risk.",
	number = "1725",
	pages = "3713--3722",
	publisher = "The Royal Society",
	title = "{Poor environmental tracking can make extinction risk insensitive to the colour of environmental noise}",
	volume = "278",
	year = "2011"
}

