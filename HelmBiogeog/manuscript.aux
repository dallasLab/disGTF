\relax 
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Both distance to mainland and island area may influence species richness and host-helminth network structure. Islands considered in the analysis are in blue, with two example networks from the Hawaiian islands and Sri Lanka highlighted in red. Hawaii is much smaller and more distant to the mainland, and also has lower species richness relative to Sri Lanka. }}{79}{}\protected@file@percent }
\newlabel{fig:concept}{{\M@TitleReference {4.1}{Both distance to mainland and island area may influence species richness and host-helminth network structure. Islands considered in the analysis are in blue, with two example networks from the Hawaiian islands and Sri Lanka highlighted in red. Hawaii is much smaller and more distant to the mainland, and also has lower species richness relative to Sri Lanka. }}{79}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Traditional island biogeography theory relates species richness to the distance to the mainland (i.e., isolation) and island area. We detect a significant positive effect of island area on both helminth parasite and host richness (A), but found no significant effect of isolation as measured by distance to mainland (B). When measuring island isolation through surrounding landmass proportion, we did detect a weak but significant positive effect of island connectivity on both helminth and host richness (C). Plotted lines represent fitted relationships from a negative binomial multivariate regression model, assuming mean values of non-focal predictor variables. Significant relationships represented as solid lines; shaded regions represent 95\% confidence intervals.}}{80}{}\protected@file@percent }
\newlabel{fig:islandBG}{{\M@TitleReference {4.2}{Traditional island biogeography theory relates species richness to the distance to the mainland (i.e., isolation) and island area. We detect a significant positive effect of island area on both helminth parasite and host richness (A), but found no significant effect of isolation as measured by distance to mainland (B). When measuring island isolation through surrounding landmass proportion, we did detect a weak but significant positive effect of island connectivity on both helminth and host richness (C). Plotted lines represent fitted relationships from a negative binomial multivariate regression model, assuming mean values of non-focal predictor variables. Significant relationships represented as solid lines; shaded regions represent 95\% confidence intervals.}}{80}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces In addition to impacting network size, island area was positively related to $NODF_c$ such that larger islands were tended to be more nested on average (top left). In contrast, neither island elevation (top right) nor measures of island isolation including distance from the mainland (bottom left) or SLMP (bottom right) were significantly related to interaction nestedness within island networks.}}{81}{}\protected@file@percent }
\newlabel{fig:networkBG}{{\M@TitleReference {4.3}{In addition to impacting network size, island area was positively related to $NODF_c$ such that larger islands were tended to be more nested on average (top left). In contrast, neither island elevation (top right) nor measures of island isolation including distance from the mainland (bottom left) or SLMP (bottom right) were significantly related to interaction nestedness within island networks.}}{81}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Islands with a terrestrial connection to the mainland during the most recent glacial maximum have significantly higher host and helminth parasite diversity (top), but exhibit no significant differences in network nestedness. Comparison labels indicate p-values from a pairwise Wilcoxon test.}}{82}{}\protected@file@percent }
\newlabel{fig:GMMC}{{\M@TitleReference {4.4}{Islands with a terrestrial connection to the mainland during the most recent glacial maximum have significantly higher host and helminth parasite diversity (top), but exhibit no significant differences in network nestedness. Comparison labels indicate p-values from a pairwise Wilcoxon test.}}{82}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Correlogram visualizing Pearson's correlation coefficients between network size (log species richness) and alternative measures of network nestedness in our data. Shaded squares represent significant correlations (p-value $<0.05$). All measures of nestedness ($\eta ${jonhson2013factors}, spectral radius, and NODF, as well as z-scores of the latter two based on null randomizations) are significantly correlated with network size in our dataset}}{85}{}\protected@file@percent }
\newlabel{fig:richnessEffect}{{\M@TitleReference {4.5}{Correlogram visualizing Pearson's correlation coefficients between network size (log species richness) and alternative measures of network nestedness in our data. Shaded squares represent significant correlations (p-value $<0.05$). All measures of nestedness ($\eta ${jonhson2013factors}, spectral radius, and NODF, as well as z-scores of the latter two based on null randomizations) are significantly correlated with network size in our dataset}}{85}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces Recreation of Figure 4.3\hbox {} of the main text using z-transformed NODF as our nestedness metric of comparison. Despite null modeling approaches, this metric may still be sensitive to network size, and this gives conflicting results to those observed in $NODF_c$. }}{86}{}\protected@file@percent }
\newlabel{fig:NODF.z_Results}{{\M@TitleReference {4.6}{Recreation of Figure 4.3\hbox {} of the main text using z-transformed NODF as our nestedness metric of comparison. Despite null modeling approaches, this metric may still be sensitive to network size, and this gives conflicting results to those observed in $NODF_c$. }}{86}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces Recreation of Figure 4.3\hbox {} of the main text using z-transformed spectral radius as our nestedness metric of comparison. In contrast to z-standardized NODF, spectral radius yields qualitatively similiar results to $NODF_c$ after z-transformation.}}{87}{}\protected@file@percent }
\newlabel{fig:Spectral.z_Results}{{\M@TitleReference {4.7}{Recreation of Figure 4.3\hbox {} of the main text using z-transformed spectral radius as our nestedness metric of comparison. In contrast to z-standardized NODF, spectral radius yields qualitatively similiar results to $NODF_c$ after z-transformation.}}{87}}
\@writefile{lot}{\contentsline {table}{\numberline {4.1}{\ignorespaces Model deviance diagnostics for host diversity models.}}{88}{}\protected@file@percent }
\newlabel{tab:host_div_deviance}{{\M@TitleReference {4.1}{Model deviance diagnostics for host diversity models.}}{88}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces Model diagnostics plots for our negative binomial model of \textbf  {parasite richness} across islands, including residual vs fitted values (top left), Q-Q plot (top right), scale-location (bottom left), and residual vs leverage plot (bottom right), with dotted lines representing Cook's distance contours of 0.5 and 1, respectively. }}{89}{}\protected@file@percent }
\newlabel{fig:parDivdiagnostics}{{\M@TitleReference {4.8}{Model diagnostics plots for our negative binomial model of \textbf  {parasite richness} across islands, including residual vs fitted values (top left), Q-Q plot (top right), scale-location (bottom left), and residual vs leverage plot (bottom right), with dotted lines representing Cook's distance contours of 0.5 and 1, respectively. }}{89}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces Model diagnostics plots for our negative binomial model of \textbf  {host richness} across islands, including residual vs fitted values (top left), Q-Q plot (top right), scale-location (bottom left), and residual vs leverage plot (bottom right), with dotted lines representing Cook's distance contours of 0.5 and 1, respectively. }}{90}{}\protected@file@percent }
\newlabel{fig:hostDivdiagnostics}{{\M@TitleReference {4.9}{Model diagnostics plots for our negative binomial model of \textbf  {host richness} across islands, including residual vs fitted values (top left), Q-Q plot (top right), scale-location (bottom left), and residual vs leverage plot (bottom right), with dotted lines representing Cook's distance contours of 0.5 and 1, respectively. }}{90}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.10}{\ignorespaces Model diagnostics plots for our generalized linear model of \textbf  {network nestedness ($NODF_c$)} across islands, including residual vs fitted values (top left), Q-Q plot (top right), scale-location (bottom left), and residual vs leverage plot (bottom right), with dotted lines representing Cook's distance contours of 0.5 and 1, respectively. }}{91}{}\protected@file@percent }
\newlabel{fig:nodfcdiagnostics}{{\M@TitleReference {4.10}{Model diagnostics plots for our generalized linear model of \textbf  {network nestedness ($NODF_c$)} across islands, including residual vs fitted values (top left), Q-Q plot (top right), scale-location (bottom left), and residual vs leverage plot (bottom right), with dotted lines representing Cook's distance contours of 0.5 and 1, respectively. }}{91}}
